{
  "name": "planner",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:frontend": "bun run --cwd frontend build",
    "build:backend": "turbo build --filter=@planner/backend",
    "db:migrate": "turbo db:migrate",
    "test": "turbo run test",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check . --write",
    "format": "bunx biome format . --write",
    "db:setup": "turbo run db:setup",
    "db:seed": "turbo run db:seed",
    "start:frontend": "turbo preview --filter=@planner/frontend",
    "start:backend": "turbo start --filter=@planner/backend",
    "health:backend": "bun --cwd backend scripts/healthcheck.js",
    "health:frontend": "bun --cwd frontend scripts/healthcheck.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "husky": "^9.1.7",
    "turbo": "^2.9.5"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  }
}
