{
  "name": "scheduler",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.12.1",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun concurrently -k -P -n api,web -c blue,green \"bun run server\" \"bun server/wait-for-api.js && bun run client {@}\" --",
    "server": "bun --watch server/server.js",
    "client": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "NODE_ENV=production bun server/server.js",
    "db:setup": "bun server/seed.js --if-empty",
    "db:seed": "bun server/seed.js",
    "test": "bun test server src"
  },
  "dependencies": {
    "@vibrant/core": "^4.0.4",
    "@vibrant/generator-default": "^4.0.4",
    "@vibrant/image-browser": "^4.0.4",
    "@vibrant/quantizer-mmcq": "^4.0.4",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "redux": "^5.0.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  },
  "trustedDependencies": []
}
